# Copy to scripts/local.env (gitignored) and fill in your machine config.
export MISTER_HOST="192.168.x.x"            # MiSTer IP on your LAN
export MISTER_SSH_KEY="$HOME/.ssh/mister_only"  # ssh key authorized on the MiSTer
export QUARTUS_BIN="/c/intelFPGA_lite/17.0/quartus/bin64"
export MISTER_HTTP_PORT="8182"              # MiSTer web API port (screenshots)
export RBF_NAME="MacIIvi.rbf"
export PROJECT_NAME="MacIIvi"

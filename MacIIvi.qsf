# Project timing constraints (read after sys/sys_top.sdc). Contains the TG68
# kernel multicycle required for reliable timing closure — see MacIIvi.sdc.
set_global_assignment -name SDC_FILE MacIIvi.sdc
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top

# ===== Fit-closure overrides (near-full design: ALM ~94%, RAM 95%) ============
# A clean from-scratch fit otherwise FAILS routing congestion (Quartus error
# 11802 / critical warning 188026), driven by heavy hold-delay insertion. These
# close it with all timing met (worst setup +0.166 ns on the HDMI/ascal domain,
# worst hold +0.244 ns):
#   * Aggressive routability        -> resolves the routing congestion.
#   * Register/logic duplication OFF -> overrides the ON's earlier in this file;
#     keeps ALM down so the HDMI setup recovers (it was -0.425 with dup left on).
# SEED history: 3 dropped ALM to 90% but broke CPU-domain (clk_sys) setup to
# -0.331 ns. 2 closed for a long stretch (+0.166..+0.183 HDMI worst) but the
# 2026-07-16 onesec-retune netlist rolled the HDMI divclk to -0.441 on it;
# sweep on that netlist: 4 -> -0.060 (HDMI divclk), 5 -> +0.081 all met. The
# violations were always HDMI-scaler-only; clk_sys/egret stayed >= +1.2.
# cd-changer netlist (1bebe75): 5 -> -0.200 (ascal o_hcpt, HDMI-only again;
# clk_sys +1.65); sweep hit first roll: 2 -> +0.109 all met, 522/553 M10K.
# family-sync netlist (ae54950): 2 -> +0.205 worst all met FIRST ROLL (HDMI
# setup +0.313, clk_sys +1.77); ALM 94%->97% (vol LUT + interp + anchor).
# option-B netlist (8bc03cb, DDR card VRAM + release swept): 2 -> -0.175
# TNS -3.3, 5 -> -0.106 TNS -0.106, 4 -> +0.123 ALL MET. HDMI-scaler-only
# throughout; clk_sys stayed >= +2.1. SEED left at 4.
# 24bpp netlist (5a6592d, no pad): 4 -> -0.048, 2 -> -0.008. Superseded.
# RELEASE netlist (8b43331 = B-shape trim + tripwire + 4:3 aspect, 50ps
# HDMI pad now ACTIVE in the sdc): 2 -> +0.003 PADDED (~+0.053 raw) all
# met FIRST ROLL; ALM 96% (port trim bought ~400), RAM 144/553. SEED 2.
# egret no_rw_check netlist (intram finally infers, -2,994 registers):
# 2 -> +0.096 PADDED (~+0.146 raw) all met FIRST ROLL; ALM 94%. The
# headroom visibly de-knifed the HDMI edge. SEED stays 2.
# soft-reboot netlist (e653e74 RESET-instruction peripheral reset):
# 2 -> +0.078 PADDED all met FIRST ROLL; ALM 94%. SEED stays 2.
# bisect netlist (misc-fixes: DDR out, SDRAM vid port back, release
# still out): 2 -> -0.196 TNS -2.4 (HDMI-only), 5 -> +0.060 PADDED all
# met; ALM 94%. SEED 5 on this branch.
# Per-fit law: every netlist change is a fresh roll — re-sweep, don't assume.
set_global_assignment -name FITTER_AGGRESSIVE_ROUTABILITY_OPTIMIZATION ALWAYS
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION OFF
set_global_assignment -name ROUTER_LCELL_INSERTION_AND_LOGIC_DUPLICATION OFF
# ==============================================================================


set_global_assignment -name QIP_FILE sys/pll_cfg.qip
set_global_assignment -name SYSTEMVERILOG_FILE rtl/dbg_probes.sv
set_global_assignment -name VERILOG_FILE rtl/mfm_track_encoder.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vram_bram.sv
set_global_assignment -name VERILOG_FILE rtl/pll_video.v

# --- m10k-repack tier 1: stop tiny delay-line shifters from eating M10K blocks.
# Baseline fit (2026-07-17 22:47, 543/553): 7 blocks held by altshift_taps at
# 1-4% utilization (shadowmask vid 324b, vga_out/vga_scaler_out din1 90/93b,
# yc phase 36b) plus 2 more by tiny core RAMs (adb kbdFifo 64b, swim
# ism_param 128b — those are pinned to MLAB in rtl/). Recognition-off is
# GLOBAL, not per-instance: Q17's shift-taps conversion works a global
# budget, so per-instance pins just moved the block to the next candidate
# (attempt 1 rolled ascal o_v_poly_phase_a2.t3 320b IN, attempt 2 vga_out
# csync1 78b, attempt 3 osd vga_osd de2 78b — whack-a-mole cannot converge).
# This core's COMPLETE altshift_taps inventory is junk-class (324/96/93/90/
# 36 bits; no 4-6Kbit ascal shifters like the ones MacLC deliberately kept),
# so global OFF costs at most ~640 registers and retires the whole class.
# Framework constrained from OUR qsf; sys/ stays stock per the framework
# files law. If a future port brings a legitimately BIG shifter, re-enable
# per-instance: ... AUTO_SHIFT_REGISTER_RECOGNITION ON -to "<instance>".
set_global_assignment -name AUTO_SHIFT_REGISTER_RECOGNITION OFF
